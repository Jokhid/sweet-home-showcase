{
  "redirects": [
    {
      "source": "/blog",
      "destination": "https://hilolegal.es/blog",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "https://hilolegal.es/blog/:path*",
      "permanent": true
    },
    {
      "source": "/herramientas/ahorro-potencial",
      "destination": "https://hilolegal.es/herramientas/ahorro-potencial/index.html",
      "permanent": true
    },
    {
      "source": "/herramientas/ahorro-potencial/:path*",
      "destination": "https://hilolegal.es/herramientas/ahorro-potencial/index.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://hilolegal.es/josecarlos/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/herramientas-home.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:path*\\.(webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
